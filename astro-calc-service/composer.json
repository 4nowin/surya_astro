{
    "name": "astro-setu/calc-service",
    "type": "project",
    "description": "Astro Setu Dedicated Astrology Calculation Service",
    "require": {
        "php": "^8.3|^8.4",
        "ext-ffi": "*",
        "ext-json": "*",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "JmeEph\\": "packages/astrology/jpl-moshier-ephemeris-php/src/",
            "JayeshMepani\\PanchangCore\\": "packages/astrology/panchang-core/src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {}
    }
}
