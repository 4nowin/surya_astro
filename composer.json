{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "google/apiclient": "^2.18",
        "google/auth": "^1.47",
        "google/cloud-firestore": "^1.50|^2.0",
        "guzzlehttp/guzzle": "^7.9|^8.0",
        "intervention/image": "^3.0|^4.0",
        "jenssegers/agent": "^2.6",
        "kreait/firebase-php": "^8.0|^7.10",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "lcobucci/jwt": "^4.3.0|^5.0",
        "mikehaertl/phpwkhtmltopdf": "^2.5",
        "monarobase/country-list": "^3.4",
        "razorpay/razorpay": "^2.9",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-sitemap": "^8.0|^7.0",
        "staudenmeir/eloquent-json-relations": "^1.15|^1.1",
        "tinymce/tinymce": "^7.0|^6.8",
        "tymon/jwt-auth": "^2.1|^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4.26",
            "ext-grpc": "1.60.0"
        },
        "audit": {
            "block": false
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
